<Window x:Class="WritingTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Writing Tools  •  Alt+Shift+G (process selected text anywhere)"
        Icon="app.ico"
        Width="700" Height="820"
        MinWidth="580" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="{DynamicResource BgDarkBrush}"
        ShowInTaskbar="True"
        Topmost="False"
        KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <!-- OLED Dark Theme Palette -->
        <Color x:Key="BgDarkColor">#0A0A0D</Color>
        <Color x:Key="BgSurfaceColor">#131318</Color>
        <Color x:Key="BgCardColor">#0E0E13</Color>
        <Color x:Key="BgSegmentTrackColor">#181820</Color>
        <Color x:Key="BgSegmentActiveColor">#2E2E3E</Color>
        <Color x:Key="BgPillColor">#1A1A24</Color>
        <Color x:Key="BgPillHoverColor">#242432</Color>
        <Color x:Key="BorderColor">#252533</Color>
        <Color x:Key="BorderLightColor">#343446</Color>
        <Color x:Key="AccentColor">#6366F1</Color>
        <Color x:Key="AccentHoverColor">#4F46E5</Color>
        <Color x:Key="AccentActiveBg">#1E1B4B</Color>
        <Color x:Key="TextPrimaryColor">#F4F4F6</Color>
        <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
        <Color x:Key="TextMutedColor">#71717A</Color>
        <Color x:Key="GreenColor">#22C55E</Color>
        <Color x:Key="RedColor">#EF4444</Color>
        <Color x:Key="YellowColor">#F59E0B</Color>

        <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
        <SolidColorBrush x:Key="BgSegmentTrackBrush" Color="{StaticResource BgSegmentTrackColor}"/>
        <SolidColorBrush x:Key="BgSegmentActiveBrush" Color="{StaticResource BgSegmentActiveColor}"/>
        <SolidColorBrush x:Key="BgPillBrush" Color="{StaticResource BgPillColor}"/>
        <SolidColorBrush x:Key="BgPillHoverBrush" Color="{StaticResource BgPillHoverColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
        <SolidColorBrush x:Key="AccentActiveBrush" Color="{StaticResource AccentActiveBg}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
        <SolidColorBrush x:Key="OverlayScrimBrush" Color="#B0000000"/>
        <SolidColorBrush x:Key="ToastBgBrush" Color="#181822"/>

        <!-- Flat Base Button Style -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab Button Style (Fills the entire slot, no inner badge) -->
        <Style x:Key="SegmentTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Pill Button Style -->
        <Style x:Key="DarkPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgPillHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Accent Button Style -->
        <Style x:Key="DarkAccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Context Menu Style (No white gutter stripe) -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Menu Item Style (Clean dark item) -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="12,6"
                                Margin="1">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Separator Style -->
        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton Style -->
        <Style x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border"
                                Background="{DynamicResource BgPillBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1">
                                    <Path x:Name="Arrow"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource AccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgPillHoverBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgPillHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgPillHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentActiveBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Style="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="280"
                                      Margin="0,4,0,8">
                                    <Border x:Name="DropDownBorder"
                                            MinWidth="230"
                                            Background="{DynamicResource BgSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Collapsible Expander Style -->
        <Style x:Key="DarkExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="Arrow" Text="›" FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="⌄"/>
                                                <Setter TargetName="Arrow" Property="Margin" Value="0,-2,6,2"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Content>
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"/>
                                </ToggleButton.Content>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Dark Input TextBox Style -->
        <Style x:Key="DarkInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Content Grid (Flush OLED dark theme, no transparent border) -->
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Model & Server Controls + History & Hotkey -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Thinking Segmented Control -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Mode Selector Segmented Bar -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Tone Presets (Quick fix) -->
            <RowDefinition Height="Auto"/> <!-- Row 4: Collapsible System Prompt & Ticket Context -->
            <RowDefinition Height="1*"/>   <!-- Row 5: Draft Input Box -->
            <RowDefinition Height="Auto"/> <!-- Row 6: Action Row (Auto-copy, status, Improve button) -->
            <RowDefinition Height="1.1*"/> <!-- Row 7: Result Box & Diff View with Stats in Header -->
            <RowDefinition Height="Auto"/> <!-- Row 8: Bottom Bar (Copy result, Quit) -->
        </Grid.RowDefinitions>

        <!-- ROW 0: MODEL & SERVER CONTROLS + HISTORY & HOTKEY -->
        <Grid x:Name="GridHeaderRow" Grid.Row="0" Margin="0,0,0,10" SizeChanged="Window_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" MaxWidth="480"/> <!-- 0: Left Group (Provider + Elastic Model Dropdown + Refresh + Server) -->
                <ColumnDefinition Width="1*" MinWidth="6"/>     <!-- 1: Elastic Spacer (absorbs extra width on wide windows) -->
                <ColumnDefinition Width="Auto"/>                <!-- 2: Right Utility Group (Theme + Settings + History + Hotkey) -->
            </Grid.ColumnDefinitions>

            <!-- LEFT GROUP: Provider + Model Dropdown (*) + Refresh + Server Controls -->
            <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- 0: Provider Selector -->
                    <ColumnDefinition Width="*"/>    <!-- 1: Model Dropdown (fills remaining left-group space) -->
                    <ColumnDefinition Width="Auto"/> <!-- 2: Refresh Button -->
                    <ColumnDefinition Width="Auto"/> <!-- 3: Server Start/Stop or Free VRAM -->
                </Grid.ColumnDefinitions>

                <!-- Status Dot & AI Provider Selector Dropdown Pill -->
                <Button x:Name="BtnProviderMenu" Grid.Column="0" Click="BtnProviderMenu_Click"
                        Height="30" VerticalAlignment="Center"
                        Style="{StaticResource DarkPillButton}" Margin="0,0,6,0" Padding="8,0"
                        ToolTip="Switch AI Provider (⚡ FastFlowLM NPU / 🎮 LM Studio GPU / 🌐 Custom)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource GreenBrush}" Margin="0,0,6,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtProviderBadge" Text="⚡ NPU" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MenuProvider" Style="{StaticResource DarkContextMenu}">
                            <MenuItem x:Name="MenuProviderNpu" Header="⚡ FastFlowLM (AMD Ryzen AI NPU)" Click="MenuProviderNpu_Click" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem x:Name="MenuProviderLmStudio" Header="🎮 LM Studio (GPU / Local Server)" Click="MenuProviderLmStudio_Click" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem x:Name="MenuProviderCustom" Header="🌐 Custom OpenAI-compatible Server" Click="MenuProviderCustom_Click" Style="{StaticResource DarkMenuItem}"/>
                            <Separator Style="{StaticResource DarkSeparator}"/>
                            <MenuItem x:Name="MenuProviderSettings" Header="⚙️ Server &amp; Provider Settings..." Click="MenuProviderSettings_Click" Style="{StaticResource DarkMenuItem}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Model Dropdown Pill (Pure Grid * sizing inside clamped 480px Left Group: never clipped, never stretched) -->
                <ComboBox x:Name="CmbModels" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                          HorizontalAlignment="Stretch" MinWidth="85" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"
                          SelectionChanged="CmbModels_SelectionChanged"
                          ToolTip="Select model from current AI provider">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Refresh Button -->
                <Button x:Name="BtnRefresh" Grid.Column="2" Click="BtnRefresh_Click"
                        Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,6,0"
                        Style="{StaticResource DarkPillButton}" Padding="0"
                        ToolTip="Refresh installed models and check server status">
                    <TextBlock Text="🔄" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Server Management: FLM Start/Stop or LM Studio Free VRAM -->
                <StackPanel x:Name="PanelServerControls" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <StackPanel x:Name="PanelFlmControls" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnStartServer" Click="BtnStartServer_Click"
                                Height="30" VerticalAlignment="Center"
                                Style="{StaticResource DarkPillButton}"
                                Padding="8,0" Margin="0,0,4,0"
                                ToolTip="Start FastFlowLM server with selected model">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStartServerBtn" Text="▶ Start" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnStopServer" Click="BtnStopServer_Click"
                                Height="30" VerticalAlignment="Center"
                                Style="{StaticResource DarkPillButton}"
                                Padding="8,0"
                                ToolTip="Stop FastFlowLM server and free NPU memory">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏹ Stop" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- LM Studio Controls (Free VRAM button) -->
                    <StackPanel x:Name="PanelLmStudioControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border x:Name="BdLmStudioStatus" Visibility="Collapsed"
                                Background="{DynamicResource BgPillBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="8,4">
                            <TextBlock x:Name="TxtLmStudioStatus" Text="LM Studio :1234" FontSize="11"/>
                        </Border>
                        <Button x:Name="BtnUnloadLmStudio" Click="BtnUnloadLmStudio_Click"
                                Height="30" VerticalAlignment="Center"
                                Style="{StaticResource DarkPillButton}" Padding="8,0"
                                ToolTip="Unload model from GPU memory and free VRAM">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUnloadLmStudioBtn" Text="⏏ Free VRAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- RIGHT UTILITY GROUP: Always measured first (Width="Auto"), never clipped -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Theme Toggle Button (Auto / Light / Dark) -->
                <Button x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click"
                        Height="30" VerticalAlignment="Center"
                        Style="{DynamicResource DarkPillButton}"
                        Margin="0,0,6,0" Padding="8,0"
                        ToolTip="Switch Theme: Auto (System) / Light / Dark">
                    <TextBlock x:Name="TxtThemeBadge" Text="🌗 Auto" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- System Settings Configuration Button -->
                <Button x:Name="BtnSettingsConfig" Click="BtnSettingsConfig_Click"
                        Width="30" Height="30" VerticalAlignment="Center"
                        Style="{DynamicResource DarkPillButton}"
                        Margin="0,0,6,0" Padding="0"
                        ToolTip="Server, Theme &amp; System Prompts Settings">
                    <TextBlock Text="⚙️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- History Pill Button -->
                <Button x:Name="BtnHistory" Click="BtnHistory_Click"
                        Height="30" VerticalAlignment="Center"
                        Style="{DynamicResource DarkPillButton}"
                        Margin="0" Padding="8,0"
                        ToolTip="Recent history (last 15 checks)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🕒" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHistoryCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Windows Hotkey Badge Pill (Same Height="30" & centered text as all buttons, auto-collapses when narrow) -->
                <Border x:Name="BdHotkeyBadge" Visibility="Collapsed" Height="30" VerticalAlignment="Center"
                        Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="8,0" Margin="6,0,0,0"
                        ToolTip="Global Windows shortcut to process highlighted text">
                    <TextBlock Text="Alt+Shift+G" FontSize="11" FontWeight="Medium"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Grid>
        <!-- ROW 1: THINKING SEGMENTED CONTROL (Full-width clean segments) -->
        <Grid x:Name="RowThinking" Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Thinking:" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>

            <Border Grid.Column="1" Background="{DynamicResource BgSegmentTrackBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="1" Height="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnThinkingAuto" Grid.Column="0" Click="BtnThinking_Click" Tag="Auto"
                            Style="{StaticResource SegmentTabButton}" Content="Auto" FontSize="12"/>

                    <Button x:Name="BtnThinkingOff" Grid.Column="1" Click="BtnThinking_Click" Tag="Off"
                            Style="{StaticResource SegmentTabButton}" Content="Off" FontSize="12"/>

                    <Button x:Name="BtnThinkingOn" Grid.Column="2" Click="BtnThinking_Click" Tag="On"
                            Style="{StaticResource SegmentTabButton}" Content="On" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: MODE SELECTOR SEGMENTED CONTROL (Full-width clean segments) -->
        <Border Grid.Row="2" Background="{DynamicResource BgSegmentTrackBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="1" Height="36" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnModeQuickFix" Grid.Column="0" Click="BtnMode_Click" Tag="QuickFix"
                        Style="{StaticResource SegmentTabButton}" Content="Quick fix"
                        ToolTip="Fix grammar, clarity, and tone of an existing reply draft (Ctrl+1)"/>

                <Button x:Name="BtnModeBrainstorm" Grid.Column="1" Click="BtnMode_Click" Tag="Brainstorm"
                        Style="{StaticResource SegmentTabButton}" Content="💡 Brainstorm"
                        ToolTip="Write rough thoughts or shorthand in your own words — AI breaks it down into a structured explanation (Ctrl+2)"/>

                <Button x:Name="BtnModeDetailed" Grid.Column="2" Click="BtnMode_Click" Tag="DetailedReview"
                        Style="{StaticResource SegmentTabButton}" Content="Detailed review"
                        ToolTip="Get Corrected, Concise, and a breakdown of grammar/style changes (Ctrl+3)"/>

                <Button x:Name="BtnModeSummarize" Grid.Column="3" Click="BtnMode_Click" Tag="Summarize"
                        Style="{StaticResource SegmentTabButton}" Content="Summarize"
                        ToolTip="Extract Core Issue, Key Details, and Customer Goal in 5 seconds (Ctrl+4)"/>
            </Grid>
        </Border>

        <!-- ROW 3: TONE & AUDIENCE PRESETS -->
        <WrapPanel x:Name="PanelTones" Grid.Row="3" Orientation="Horizontal"
                   HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="BtnToneStandard" Click="BtnTone_Click" Tag="Standard"
                    Style="{StaticResource FlatButton}" Margin="0,0,5,4"
                    ToolTip="Standard customer support reply — natural, warm, and helpful">
                <Border x:Name="BdToneStandard" Background="{DynamicResource AccentActiveBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneStandard" Text="✨ Standard" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
            </Button>

            <Button x:Name="BtnToneFriendly" Click="BtnTone_Click" Tag="Friendly"
                    Style="{StaticResource FlatButton}" Margin="0,0,5,4"
                    ToolTip="Warm, empathetic, and approachable customer tone">
                <Border x:Name="BdToneFriendly" Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneFriendly" Text="🤝 Friendly" FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Button>

            <Button x:Name="BtnToneConcise" Click="BtnTone_Click" Tag="Concise"
                    Style="{StaticResource FlatButton}" Margin="0,0,5,4"
                    ToolTip="Short, direct, and efficient without extra fluff">
                <Border x:Name="BdToneConcise" Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneConcise" Text="⚡️ Concise" FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Button>

            <Button x:Name="BtnToneDeescalate" Click="BtnTone_Click" Tag="Deescalate"
                    Style="{StaticResource FlatButton}" Margin="0,0,5,4"
                    ToolTip="Calm, reassuring, and diplomatic tone to de-escalate frustrated customers">
                <Border x:Name="BdToneDeescalate" Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneDeescalate" Text="🛡️ De-escalate" FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Button>

            <Button x:Name="BtnToneFormal" Click="BtnTone_Click" Tag="Formal"
                    Style="{StaticResource FlatButton}" Margin="0,0,5,4"
                    ToolTip="Strictly professional, structured business tone">
                <Border x:Name="BdToneFormal" Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneFormal" Text="👔 Formal" FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Button>

            <Button x:Name="BtnToneRephrase" Click="BtnTone_Click" Tag="Rephrase"
                    Style="{StaticResource FlatButton}" Margin="0,0,5,4"
                    ToolTip="Paraphrase with fresh wording so repeated / follow-up replies to a user don't look copy-pasted">
                <Border x:Name="BdToneRephrase" Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneRephrase" Text="🔄 Rephrase" FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Button>

            <Button x:Name="BtnToneInternal" Click="BtnTone_Click" Tag="Internal"
                    Style="{StaticResource FlatButton}" Margin="0,0,0,4"
                    ToolTip="Edit internal ticket notes or messages to colleagues (direct, teammate-to-teammate tone)">
                <Border x:Name="BdToneInternal" Background="{DynamicResource BgPillBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="10,5">
                    <TextBlock x:Name="TxtToneInternal" Text="💬 Internal" FontSize="12" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </Button>
        </WrapPanel>

        <!-- ROW 4: TICKET CONTEXT (Optional) -->
        <Border x:Name="BdContextContainer" Grid.Row="4" Margin="0,0,0,8"
                Background="Transparent" BorderBrush="Transparent"
                BorderThickness="1" CornerRadius="8" Padding="8,2">
            <!-- Ticket Context Expander -->
            <Expander x:Name="ExpContext" Style="{StaticResource DarkExpander}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblContextHeader" Text="Ticket context / Client message / Instructions (optional)" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="BadgeContextActive" Visibility="Collapsed"
                                Background="#143525" BorderBrush="#22C55E" BorderThickness="1"
                                CornerRadius="6" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtContextBadge" Text="● Context active" FontSize="10.5"
                                       FontWeight="SemiBold" Foreground="#4ADE80"/>
                        </Border>
                        <TextBlock x:Name="TxtContextPreview" Visibility="Collapsed" Text=""
                                   FontSize="11" FontStyle="Italic"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnHeaderContextClear" Visibility="Collapsed"
                                Click="BtnContextClear_Click" Style="{StaticResource DarkPillButton}"
                                Content="✕ Clear" FontSize="10" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center" ToolTip="Clear ticket context"/>
                    </StackPanel>
                </Expander.Header>
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox x:Name="TxtContext" Height="72"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="TxtContext_TextChanged"/>
                            <TextBlock x:Name="TxtContextWatermark"
                                       Text="Paste client's message / ticket context, OR add specific processing instructions (e.g., &quot;make it shorter&quot;, &quot;politely decline refund&quot;, &quot;explain step-by-step&quot;, &quot;translate to English&quot;)..."
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11.5" TextWrapping="Wrap"
                                       Margin="4,2,4,0" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Click="BtnContextPaste_Click" Style="{StaticResource DarkPillButton}"
                                    Content="Paste" Padding="8,2" Margin="0,0,6,0"/>
                            <Button Click="BtnContextClear_Click" Style="{StaticResource DarkPillButton}"
                                    Content="Clear" Padding="8,2"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>
        </Border>
        <!-- ROW 5: DRAFT INPUT BOX -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Draft header -->
                <RowDefinition Height="*"/>    <!-- Text card -->
            </Grid.RowDefinitions>

            <!-- Draft Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Draft Label -->
                    <ColumnDefinition Width="Auto"/> <!-- Paste -->
                    <ColumnDefinition Width="Auto"/> <!-- Transform -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Word count -->
                    <ColumnDefinition Width="Auto"/> <!-- Clear -->
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LblInputTitle" Grid.Column="0" Text="Draft" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Click="BtnDraftPaste_Click" Style="{StaticResource DarkPillButton}"
                        Content="Paste" Padding="8,3" Margin="0,0,6,0"/>

                <Button x:Name="BtnTransform" Grid.Column="2" Click="BtnTransform_Click"
                        Style="{StaticResource DarkPillButton}" Padding="8,3" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Aa Transform" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text=" ▾" FontSize="9" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MenuTransform" Style="{StaticResource DarkContextMenu}">
                            <MenuItem Header="Make UPPERCASE" Click="MenuTransform_UpperCase" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem Header="Make lowercase" Click="MenuTransform_LowerCase" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem Header="Capitalize Words" Click="MenuTransform_Capitalize" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem Header="Sentence case" Click="MenuTransform_SentenceCase" Style="{StaticResource DarkMenuItem}"/>
                            <Separator Style="{StaticResource DarkSeparator}"/>
                            <MenuItem Header="Clean Extra Spaces" Click="MenuTransform_CleanSpaces" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem Header="Straighten Quotes («» → &quot;&quot;)" Click="MenuTransform_StraightenQuotes" Style="{StaticResource DarkMenuItem}"/>
                            <MenuItem Header="Remove Line Breaks" Click="MenuTransform_RemoveLineBreaks" Style="{StaticResource DarkMenuItem}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <TextBlock x:Name="TxtInputCount" Grid.Column="4" Text="" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Grid.Column="5" Click="BtnDraftClear_Click" Style="{StaticResource DarkPillButton}"
                        Content="Clear" Padding="8,3" ToolTip="Clear both draft and result text"/>
            </Grid>

            <!-- Draft Text Box (OLED Dark Card) -->
            <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBox x:Name="TxtDraft"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"
                             Padding="10,8"
                             TextChanged="TxtDraft_TextChanged"/>

                    <TextBlock x:Name="TxtDraftWatermark"
                               Text="Type or paste your customer reply draft here..."
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" FontStyle="Normal"
                               TextWrapping="Wrap"
                               Margin="12,10"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 6: ACTION ROW (Auto-copy, Ellipsis Status, Non-colliding Improve Button) -->
        <Grid Grid.Row="6" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Auto-copy -->
                <ColumnDefinition Width="*"/>    <!-- Status Text with Ellipsis (no overflow!) -->
                <ColumnDefinition Width="Auto"/> <!-- Improve / Stop Button -->
            </Grid.ColumnDefinitions>

            <!-- Auto-copy Checkbox -->
            <CheckBox x:Name="ChkAutoCopy" Grid.Column="0" Content="Auto-copy" IsChecked="True"
                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                      VerticalAlignment="Center" Margin="2,0,12,0"/>

            <!-- Status Text with clean CharacterEllipsis -->
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="True">
                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Right Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Stop Button (during streaming) -->
                <Button x:Name="BtnStop" Click="BtnStop_Click" Visibility="Collapsed"
                        Style="{StaticResource DarkPillButton}" Margin="0,0,8,0" Padding="12,6">
                    <TextBlock Text="⏹ Stop" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource RedBrush}"/>
                </Button>

                <!-- Improve Button (Windows Shortcut Ctrl+Enter) -->
                <Button x:Name="BtnImprove" Click="BtnImprove_Click"
                        Style="{StaticResource DarkAccentButton}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtImproveBtn" Text="Improve" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text=" (Ctrl+Enter)" FontSize="11" Foreground="#C7D2FE" Margin="4,1,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 7: RESULT BOX & DIFF VIEW WITH TOK/S STATS IN HEADER -->
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Result header & Diff switch -->
                <RowDefinition Height="*"/>    <!-- Result Card -->
            </Grid.RowDefinitions>

            <!-- Result Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Result Label -->
                    <ColumnDefinition Width="*"/>    <!-- Tok/s Stats in header (spacious, zero collision!) -->
                    <ColumnDefinition Width="Auto"/> <!-- Text / Diff Switch -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Result" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtResultCount" Text="" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>

                <!-- Live Tok/s Stats in Header -->
                <TextBlock x:Name="TxtHeaderStats" Grid.Column="1" Text="" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Diff Switch Segmented Pill -->
                <Border x:Name="PanelDiffSwitch" Grid.Column="2" Background="{DynamicResource BgSegmentTrackBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="1" Height="26">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnViewText" Click="BtnViewText_Click"
                                Style="{StaticResource SegmentTabButton}" Content="Text" FontSize="11" Padding="12,0"/>
                        <Button x:Name="BtnViewDiff" Click="BtnViewDiff_Click"
                                Style="{StaticResource SegmentTabButton}" Content="Diff" FontSize="11" Padding="12,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Result Box (OLED Dark Card) -->
            <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <!-- Regular Text View -->
                    <TextBox x:Name="TxtResult"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"
                             Padding="10,8"
                             TextChanged="TxtResult_TextChanged"/>

                    <!-- Visual Diff View -->
                    <RichTextBox x:Name="RtfDiff" Visibility="Collapsed"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13" FontFamily="Segoe UI Variable, Segoe UI"
                                 Padding="10,8"/>

                    <!-- Empty Result Placeholder -->
                    <TextBlock x:Name="TxtResultEmpty"
                               Text=""
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" FontStyle="Italic"
                               TextWrapping="Wrap"
                               Margin="12,10"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 8: BOTTOM BAR (Copy Result, System Telemetry, Quit) -->
        <Grid Grid.Row="8" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Copy Result Button -->
                <ColumnDefinition Width="*"/>    <!-- Telemetry Bar -->
                <ColumnDefinition Width="Auto"/> <!-- Quit Button -->
            </Grid.ColumnDefinitions>

            <!-- Copy Result Pill Button (Windows Shortcut Ctrl+Shift+C) -->
            <Button x:Name="BtnSmartCopy" Grid.Column="0" Click="BtnSmartCopy_Click"
                    Style="{StaticResource DarkPillButton}" Padding="12,6"
                    ToolTip="Copy result (or CORRECTED block in Detailed review) (Ctrl+Shift+C)">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Copy Result (Ctrl+Shift+C)" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- LM Studio-style System Telemetry: RAM & NPU stats -->
            <Border x:Name="BdSystemMetrics" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgPillBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="12,5"
                    ToolTip="System Telemetry: Physical RAM &amp; AMD Ryzen AI NPU Load">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Memory / RAM -->
                    <TextBlock Text="RAM:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TxtRamStats" Text="-- / -- GB (--%)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>

                    <!-- Subtle vertical separator -->
                    <Border Width="1" Height="11" Background="{DynamicResource BorderBrush}" Margin="0,0,12,0"/>

                    <!-- Dynamic Compute Device (NPU / GPU) -->
                    <TextBlock x:Name="LblComputeDevice" Text="NPU:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                    <Ellipse x:Name="DotNpuTelemetry" Width="6" Height="6" Fill="#71717A" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtNpuStats" Text="0% (Idle)" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Hidden field for stats compatibility if referenced -->
            <TextBlock x:Name="TxtStats" Visibility="Collapsed"/>

            <!-- Quit Button (Exits application completely) -->
            <Button x:Name="BtnQuit" Grid.Column="2" Click="BtnQuit_Click"
                    Style="{StaticResource DarkPillButton}" Padding="16,6"
                    ToolTip="Exit Writing Tools completely">
                <TextBlock Text="Quit" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Button>
        </Grid>

        <!-- OVERLAY: HISTORY DRAWER MODAL (Dark Theme) -->
        <Border x:Name="OverlayHistory" Grid.Row="0" Grid.RowSpan="9"
                Background="{DynamicResource OverlayScrimBrush}" Visibility="Collapsed" CornerRadius="8">
            <Border Width="560" Height="580" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Recent History" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text=" (last 15 checks)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <Button Click="BtnCloseHistory_Click" HorizontalAlignment="Right"
                                Style="{StaticResource FlatButton}" Padding="4">
                            <TextBlock Text="✕" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- History List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ListHistoryItems"/>
                    </ScrollViewer>

                    <!-- History Actions -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Button Click="BtnClearHistory_Click" HorizontalAlignment="Left"
                                Style="{StaticResource DarkPillButton}" Padding="10,5">
                            <TextBlock Text="Clear History" FontSize="11" Foreground="{DynamicResource RedBrush}"/>
                        </Button>

                        <Button Click="BtnCloseHistory_Click" HorizontalAlignment="Right"
                                Style="{StaticResource DarkPillButton}" Padding="14,5">
                            <TextBlock Text="Close" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY: SETTINGS & CONFIGURATION MODAL (Server & System Prompts) -->
        <Border x:Name="OverlaySettings" Grid.Row="0" Grid.RowSpan="9"
                Background="{DynamicResource OverlayScrimBrush}" Visibility="Collapsed" CornerRadius="8">
            <Border Width="620" MaxHeight="600" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Close X -->
                        <RowDefinition Height="Auto"/> <!-- Top Level Tabs: Server vs System Prompts -->
                        <RowDefinition Height="*"/>    <!-- Active Tab Content -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Settings &amp; Configuration" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSettingsSubheader" Text=" (Server &amp; System Prompts)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Click="BtnCloseSettings_Click" HorizontalAlignment="Right"
                                Style="{StaticResource FlatButton}" Padding="4">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <!-- Top-Level Tab Switcher: Server & Provider vs Prompts -->
                    <Border Grid.Row="1" Background="{DynamicResource BgSegmentTrackBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="1" Height="36" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSettingsTabServer" Grid.Column="0" Click="BtnSettingsTabServer_Click"
                                    Style="{StaticResource SegmentTabButton}" Content="⚙️ Server &amp; AI Provider" FontSize="12" FontWeight="SemiBold"/>

                            <Button x:Name="BtnSettingsTabPrompts" Grid.Column="1" Click="BtnSettingsTabPrompts_Click"
                                    Style="{StaticResource SegmentTabButton}" Content="📝 System Prompts" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- TAB 1: SERVER & PROVIDER CONFIGURATION -->
                    <Grid x:Name="PanelSettingsServer" Grid.Row="2" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Appearance / Theme Selection -->
                                <TextBlock Text="Appearance Theme:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Border Background="{DynamicResource BgSegmentTrackBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="1" Height="32" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnThemeSystem" Grid.Column="0" Click="BtnThemeOption_Click" Tag="System"
                                                Style="{StaticResource SegmentTabButton}" Content="🌗 System (Auto)" FontSize="11.5"/>
                                        <Button x:Name="BtnThemeLight" Grid.Column="1" Click="BtnThemeOption_Click" Tag="Light"
                                                Style="{StaticResource SegmentTabButton}" Content="☀️ Light" FontSize="11.5"/>
                                        <Button x:Name="BtnThemeDark" Grid.Column="2" Click="BtnThemeOption_Click" Tag="Dark"
                                                Style="{StaticResource SegmentTabButton}" Content="🌙 Dark" FontSize="11.5"/>
                                    </Grid>
                                </Border>

                                <!-- Provider Selection -->
                                <TextBlock Text="AI Backend Provider:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Provider 1: FastFlowLM NPU -->
                                    <Button x:Name="BtnProviderCardNpu" Grid.Column="0" Click="BtnProviderCard_Click" Tag="FastFlowLmNpu"
                                            Style="{StaticResource FlatButton}">
                                        <Border x:Name="BdProviderCardNpu" Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"
                                                CornerRadius="8" Padding="10,10">
                                            <StackPanel>
                                                <TextBlock Text="⚡ FastFlowLM" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                                <TextBlock Text="AMD Ryzen AI NPU" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Local laptop NPU, 0% GPU load, battery efficient" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Provider 2: LM Studio GPU -->
                                    <Button x:Name="BtnProviderCardLmStudio" Grid.Column="2" Click="BtnProviderCard_Click" Tag="LmStudio"
                                            Style="{StaticResource FlatButton}">
                                        <Border x:Name="BdProviderCardLmStudio" Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                                CornerRadius="8" Padding="10,10">
                                            <StackPanel>
                                                <TextBlock Text="🎮 LM Studio" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                                <TextBlock Text="GPU / Desktop PC" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Desktop PC with GPU server on :1234, deepseek, qwen, llama" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>

                                    <!-- Provider 3: Custom / Ollama -->
                                    <Button x:Name="BtnProviderCardCustom" Grid.Column="4" Click="BtnProviderCard_Click" Tag="Custom"
                                            Style="{StaticResource FlatButton}">
                                        <Border x:Name="BdProviderCardCustom" Background="{DynamicResource BgCardBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                                CornerRadius="8" Padding="10,10">
                                            <StackPanel>
                                                <TextBlock Text="🌐 Custom / Ollama" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                                                <TextBlock Text="OpenAI Compatible" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource YellowBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="Ollama, vLLM, or custom local/network server" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>

                                <!-- Server URL -->
                                <TextBlock Text="Server Base URL (OpenAI API Compatible):" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtSettingsServerUrl" Style="{StaticResource DarkInputTextBox}"
                                         Margin="0,0,0,8"/>

                                <!-- Preset URL buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="Presets:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Click="BtnPresetUrl_Click" Tag="http://localhost:1234"
                                            Style="{StaticResource DarkPillButton}" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="🎮 LM Studio (:1234)" FontSize="10.5"/>
                                    </Button>
                                    <Button Click="BtnPresetUrl_Click" Tag="http://127.0.0.1:52625"
                                            Style="{StaticResource DarkPillButton}" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="⚡ FLM NPU (:52625)" FontSize="10.5"/>
                                    </Button>
                                    <Button Click="BtnPresetUrl_Click" Tag="http://localhost:11434"
                                            Style="{StaticResource DarkPillButton}" Padding="8,3">
                                        <TextBlock Text="🦙 Ollama (:11434)" FontSize="10.5"/>
                                    </Button>
                                </StackPanel>

                                <!-- API Key (optional) -->
                                <TextBlock Text="API Key (optional for local servers):" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtSettingsApiKey" Style="{StaticResource DarkInputTextBox}"
                                         Margin="0,0,0,14"/>

                                <!-- Test Connection Row -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnTestConnection" Grid.Column="0" Click="BtnTestConnection_Click"
                                            Style="{StaticResource DarkPillButton}" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔍 Test Connection" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock x:Name="TxtTestConnectionResult" Grid.Column="1" Text=""
                                               FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"
                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Informational guide -->
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="💡 Quick Guide for LM Studio (on Desktop PC):" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="1. Open LM Studio on your PC and load your desired model (e.g. Qwen, Llama, DeepSeek)." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="2. Go to the Developer / Local Server tab in LM Studio and click 'Start Server' (runs on port 1234)." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="3. Click 'Test Connection' above. Once verified, click 'Save &amp; Apply'. Models will appear in the main dropdown!" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- TAB 2: SYSTEM PROMPTS CONFIGURATION -->
                    <Grid x:Name="PanelSettingsPrompts" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Mode Selector Tabs -->
                            <RowDefinition Height="*"/>    <!-- Text Editor -->
                        </Grid.RowDefinitions>

                        <!-- Mode Segmented Tabs -->
                        <Border Grid.Row="0" Background="{DynamicResource BgSegmentTrackBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="1" Height="34" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnPromptTabQuickFix" Grid.Column="0" Click="BtnPromptTab_Click" Tag="QuickFix"
                                        Style="{StaticResource SegmentTabButton}" Content="Quick fix" FontSize="12"/>

                                <Button x:Name="BtnPromptTabBrainstorm" Grid.Column="1" Click="BtnPromptTab_Click" Tag="Brainstorm"
                                        Style="{StaticResource SegmentTabButton}" Content="Brainstorm" FontSize="12"/>

                                <Button x:Name="BtnPromptTabDetailed" Grid.Column="2" Click="BtnPromptTab_Click" Tag="DetailedReview"
                                        Style="{StaticResource SegmentTabButton}" Content="Detailed review" FontSize="12"/>

                                <Button x:Name="BtnPromptTabSummarize" Grid.Column="3" Click="BtnPromptTab_Click" Tag="Summarize"
                                        Style="{StaticResource SegmentTabButton}" Content="Summarize" FontSize="12"/>
                            </Grid>
                        </Border>

                        <!-- Text Editor -->
                        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <TextBox x:Name="TxtPromptEditor"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     BorderThickness="0"
                                     FontSize="12" FontFamily="Consolas, Segoe UI"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="200" MaxHeight="270"/>
                        </Border>
                    </Grid>

                    <!-- Actions Footer -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Button x:Name="BtnResetPrompt" Click="BtnResetPrompt_Click" HorizontalAlignment="Left"
                                Style="{StaticResource DarkPillButton}" Padding="12,6" Visibility="Collapsed"
                                ToolTip="Reset prompt for current mode to factory default">
                            <TextBlock Text="Reset Prompt to Default" FontSize="12" Foreground="{DynamicResource RedBrush}"/>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCloseSettings" Click="BtnCloseSettings_Click"
                                    Style="{StaticResource DarkPillButton}" Padding="14,6" Margin="0,0,8,0">
                                <TextBlock Text="Cancel" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>

                            <Button x:Name="BtnSaveSettings" Click="BtnSaveSettings_Click"
                                    Style="{StaticResource DarkAccentButton}" Padding="18,6">
                                <TextBlock Text="Save &amp; Apply" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Floating Notification Toast (Auto-dismisses with clear status feedback) -->
        <Border x:Name="BdNotificationToast"
                Grid.Row="0" Grid.RowSpan="9"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0"
                Background="{DynamicResource ToastBgBrush}"
                BorderBrush="{DynamicResource GreenBrush}" BorderThickness="1.5"
                CornerRadius="8" Padding="14,8"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtNotificationIcon" Text="✓" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNotificationMessage" Text="FastFlowLM server stopped successfully"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
